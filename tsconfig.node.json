{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "src/lesson-registry.mjs", "src/lesson-graph.mjs", "src/map-poc-graph.mjs", "src/question-registry.mjs", "src/question-generator.mjs", "scripts/question-contract.fixture.mjs", "scripts/lesson-contract.fixture.mjs", "scripts/lesson-graph.typecheck.mjs", "src/question-grading.mjs", "scripts/question-grading.typecheck.mjs"]
}
